#!/bin/sh
# Cross-drive CMake for QNX 6.5 armle-v7 in the toolchain image. Run from the
# project dir (cwd -> /src):
#   qnx-cmake -S . -B build      # configure (QNX toolchain file auto-added)
#   qnx-cmake --build build      # build
# The toolchain file is injected only on a configure invocation.
IMG=qnx65-armv7-toolchain
docker image inspect "$IMG" >/dev/null 2>&1 || { echo "image '$IMG' missing - run host-scripts/qnx-run.sh build" >&2; exit 1; }
case " $* " in
    *" --build "*|*" --install "*|*" --version "*|*" -E "*) TC= ;;
    *) TC=-DCMAKE_TOOLCHAIN_FILE=/opt/qnx-cross/qnx-armv7.cmake ;;
esac
exec docker run --rm --platform=linux/amd64 -v "$PWD":/src "$IMG" cmake $TC "$@"
