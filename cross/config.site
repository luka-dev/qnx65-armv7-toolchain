# Autotools config.site for cross-compiling to QNX 6.5 armle-v7.
#   CONFIG_SITE=/opt/qnx-cross/config.site \
#       ./configure --host=arm-unknown-nto-qnx6.5.0eabi <args>
# (or use the qnx-configure host wrapper). Pre-answers the AC_TRY_RUN checks a
# cross-compiler can't execute - the root of "cannot run test program" and the
# gnulib conftest failures - and sets sane default tools/flags.

: "${CC:=arm-unknown-nto-qnx6.5.0eabi-gcc}"
: "${CXX:=arm-unknown-nto-qnx6.5.0eabi-g++}"
: "${CPP:=arm-unknown-nto-qnx6.5.0eabi-gcc -E}"
: "${AR:=arm-unknown-nto-qnx6.5.0eabi-ar}"
: "${RANLIB:=arm-unknown-nto-qnx6.5.0eabi-ranlib}"
: "${STRIP:=arm-unknown-nto-qnx6.5.0eabi-strip}"

# QNX Dinkum headers don't pull <stddef.h> transitively for gnulib-style code
# that ships its own <stddef.h> substitute; force it so size_t/ptrdiff_t are
# always defined. Belt-and-braces: the gcc itself already defines _QNX_SOURCE
# and resolves the static-only libc funcs (regex/glob/...) via -l:libc.a.
CPPFLAGS="-include stddef.h${CPPFLAGS:+ $CPPFLAGS}"

# pkg-config: sysroot only, no host .pc leak.
: "${PKG_CONFIG_SYSROOT_DIR:=/opt/qnx650/target/qnx6}"
: "${PKG_CONFIG_LIBDIR:=/opt/qnx650/target/qnx6/armle-v7/usr/lib/pkgconfig}"
export PKG_CONFIG_SYSROOT_DIR PKG_CONFIG_LIBDIR

# --- run-test results the cross build can't determine by executing ---
# Each uses ${var=default} so an explicit environment override still wins.
ac_cv_c_bigendian=${ac_cv_c_bigendian=no}

# malloc/realloc(0) return non-NULL (QNX/glibc semantics) - stops gnulib from
# substituting rpl_malloc/rpl_realloc.
ac_cv_func_malloc_0_nonnull=${ac_cv_func_malloc_0_nonnull=yes}
ac_cv_func_realloc_0_nonnull=${ac_cv_func_realloc_0_nonnull=yes}
gl_cv_func_malloc_0_nonnull=${gl_cv_func_malloc_0_nonnull=1}
gl_cv_func_realloc_0_nonnull=${gl_cv_func_realloc_0_nonnull=1}

# common "does this libc function work" probes
ac_cv_func_memcmp_working=${ac_cv_func_memcmp_working=yes}
ac_cv_func_mmap_fixed_mapped=${ac_cv_func_mmap_fixed_mapped=yes}
ac_cv_func_strtod=${ac_cv_func_strtod=yes}
ac_cv_func_strnlen_working=${ac_cv_func_strnlen_working=yes}
ac_cv_func_strerror_r_char_p=${ac_cv_func_strerror_r_char_p=no}
ac_cv_func_setvbuf_reversed=${ac_cv_func_setvbuf_reversed=no}

# time-related run-tests gnulib gates on
ac_cv_func_working_mktime=${ac_cv_func_working_mktime=yes}
gl_cv_func_working_mktime=${gl_cv_func_working_mktime=yes}
gl_cv_func_gettimeofday_clobber=${gl_cv_func_gettimeofday_clobber=no}
gl_cv_func_tzset_clobber=${gl_cv_func_tzset_clobber=no}

# NOTE: gnulib defines hundreds of gl_cv_* run-tests; this covers the frequent
# offenders. If a specific project's configure still stalls on "cannot run test
# program", add its ac_cv_*/gl_cv_* here (or export it before ./configure).
