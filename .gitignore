.DS_Store
installLog.txt

# Go build outputs - make.bash regenerates these; only src/ + lib/ are vendored.
go/bin/
go/pkg/

# User-dropped toolchains in tools/ are large third-party binaries - keep the
# repo for the recipe, not the blobs. Track structure via tools/.keep + README.
# EXCEPTION: tools/qcc/ is a bundled shim script (not a blob) - track it.
tools/*/
!tools/.keep
!tools/qcc/
!tools/qcc/**

# NOTE: do NOT add target/ or *.so/*.a here - the QNX sysroot (sdp/target/qnx6/...)
# and its libraries live in this repo and must stay tracked.

# Rust unwind shim: .a/.o rebuilt from shim/unwind_shim.c at image build
rust/shim/*.o
rust/shim/*.a
