.DS_Store
installLog.txt

# Go build outputs - make.bash regenerates these; only src/ + lib/ are vendored.
go/bin/
go/pkg/

# User-dropped toolchains in tools/ are large third-party binaries - keep the
# repo for the recipe, not the blobs (tools/README documents the mechanism).
# EXCEPTIONS: qcc and gas-compat are bundled shim scripts (not blobs).
tools/*/
!tools/qcc/
!tools/qcc/**
!tools/gas-compat/
!tools/gas-compat/**

# NOTE: do NOT add target/ or *.so/*.a here - the QNX sysroot (sdp/target/qnx6/...)
# and its libraries live in this repo and must stay tracked.

# Rust unwind shim: .a/.o rebuilt from shim/unwind_shim.c at image build
rust/shim/*.o
rust/shim/*.a

# ports/: downloaded source tarballs (build.sh re-fetches on demand) and logs.
# The built sysroot/ libraries stay tracked, like the rest of the QNX sysroot.
ports/**/*.tar.*
ports/**/build.log
