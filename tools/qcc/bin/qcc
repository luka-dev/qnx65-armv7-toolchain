#!/usr/bin/env bash
# qcc shim -> this image's cross GCC 4.9. A faithful QNX-qcc-to-gcc translator so
# anything that invokes `qcc` works against our GCC (mkifs [linker=] specs,
# qcc-based Makefiles, hand invocations). This image replaced the stock SDP qcc
# with GCC directly; without this shim, `mkifs` fails "qcc: not found" when it
# links a relocatable startup into an IFS.
#
# Option handling was derived from the decompiled stock 6.5 qcc (main's argv
# switch): every option qcc forwards to the compiler/assembler/linker is already
# gcc-compatible (-c/-S/-E/-g/-O*/-I/-D/-U/-L/-l/-f*/-m*/-p/-v/-w/-x/-ansi/-W{p,a,l},
# -shared/-static/-std=/-M*/-o/-nostdlib/-nostartfiles/-nodefaultlibs/-nostdinc*)
# so it passes straight through. Only qcc's own driver options are translated:
#
#   -V[ver,]variant  selects a compiler profile; also picks C vs C++ and the C++
#                    library. We have one target + GNU libstdc++, so we drop the
#                    profile but honour its language: *cpp/*gpp/*acpp/*ecpp/*c++
#                    -> use g++ (so C++ links libstdc++), else gcc.
#   -Y<variant>      older spelling of the profile selector -> same handling.
#   -bootstrap       link with no standard startup/libs -> gcc -nostdlib.
#   -nostartup       no crt startup files -> gcc -nostartfiles.
#   -nopipe          use temp files not pipes (gcc's default) -> dropped.
#   -nostdlib++      no C++ stdlib -> link via the C driver (gcc 4.9 has no
#                    -nostdlib++; the C driver compiles C++ but omits libstdc++).
#   -a <archive>     librarian mode (QNX's qcc-driver make builds static libs
#                    with `qcc -a`) -> run `<target>-ar rc <archive> <objs>`.
#   -EL / -EB        endianness -> -mlittle-endian / -mbig-endian.
# (Bare -M is NOT special-cased: qcc-gcc treats it as gcc does - emit make
# dependencies - so it passes through. Only the Watcom driver used -M for a link
# map, which this gcc toolchain never invokes.)
#   -Wc,a,b          options for the compiler proper -> pass a b straight to gcc.
#   -lang-c++/-c/-asm  source language override -> -x c++ / c / assembler.
#   @file            response file -> expanded and re-translated.
#   C++ source (.cc/.cpp/.cxx/.C/.c++/.mm) also selects g++.
#
# Env: QCC_TARGET (triplet, default arm-unknown-nto-qnx6.5.0eabi), QCC_CC/QCC_CXX
#      to override the drivers, QCC_DEBUG=1 to echo the rewritten command.
set -u
: "${QCC_TARGET:=arm-unknown-nto-qnx6.5.0eabi}"
CC="${QCC_CC:-${QCC_TARGET}-gcc}"
CXX="${QCC_CXX:-${QCC_TARGET}-g++}"

want_cxx=0
args=()
ar_target=""      # set by qcc's -a (librarian mode); handled after translate()

# qcc picks C vs C++ by the driver name too (CC / c++ -> C++). Match that.
case "$(basename -- "$0")" in CC|c++|*-c++|g++|*-g++) want_cxx=1 ;; esac

# mark C++ if the variant name names a C++ library/profile
variant_lang() {
    case "$1" in
        *cpp*|*gpp*|*acpp*|*ecpp*|*c++*) want_cxx=1 ;;
    esac
}

translate() {
    while [ $# -gt 0 ]; do
        a="$1"; shift
        case "$a" in
            @?*)                                    # response file: expand + retranslate
                f="${a#@}"
                if [ -f "$f" ]; then
                    # shellcheck disable=SC2046
                    set -- $(cat "$f") "$@"
                else args+=("$a"); fi
                ;;
            -V|-Y)     variant_lang "${1:-}"; shift || true ;;   # separate arg form
            -V*)       variant_lang "${a#-V}" ;;                  # -Vspec
            -Y*)       variant_lang "${a#-Y}" ;;
            -bootstrap) args+=(-nostdlib) ;;
            -nostartup) args+=(-nostartfiles) ;;         # qcc: no crt startup -> gcc -nostartfiles
            -nopipe)   ;;                                # qcc: use temp files, not pipes - gcc's default; drop
            -nostdlib++) force_cdriver=1 ;;              # qcc: no C++ stdlib. GCC 4.9 lacks -nostdlib++
                                                         # (added in gcc 9), so link via the C driver: it
                                                         # still compiles C++ (cc1plus) but never auto-adds
                                                         # libstdc++ - the -nostdlib++ intent.
            -a)        ar_target="${1:-}"; shift || true ;;  # qcc librarian: qcc -a <archive> <objs> -> ar (after translate)
            -EL)       args+=(-mlittle-endian) ;;
            -EB)       args+=(-mbig-endian) ;;
            -lang-c++) want_cxx=1; args+=(-x c++) ;;
            -lang-c)   args+=(-x c) ;;
            -lang-asm) args+=(-x assembler) ;;
            # qcc C++-library / Intel-compiler selectors: N/A with one GNU
            # libstdc++ target -> drop (else gcc chokes on -cxxlib / -*-intel).
            -cxxlib|-cxxlib-*|-no-cxxlib|-*-intel) ;;
            -Wc,*)     IFS=',' read -ra _p <<< "${a#-Wc,}"; args+=("${_p[@]}") ;;
            *.cc|*.cpp|*.cxx|*.[Cc]++|*.C|*.mm|*.CPP|*.CXX)
                       want_cxx=1; args+=("$a") ;;
            *)         args+=("$a") ;;
        esac
    done
}

translate "$@"

# qcc -a <archive> <objs>: build a static library. QNX's qcc-driver make rules
# use `qcc -V... -a` as the librarian (AR_nto_arm_gcc_qcc in qconf-*.mk), so a
# qcc-based static-lib build lands here. Run binutils ar directly - ar rc =
# create/replace - over the object inputs. QCC_AR overrides the archiver.
if [ -n "$ar_target" ]; then
    ar_objs=()
    for x in "${args[@]:-}"; do case "$x" in *.o|*.a) ar_objs+=("$x") ;; esac; done
    ar="${QCC_AR:-${QCC_TARGET}-ar}"
    [ -n "${QCC_DEBUG:-}" ] && printf 'qcc-shim: %s rc %s%s\n' "$ar" "$ar_target" "$(printf ' %s' "${ar_objs[@]:-}")" >&2
    rm -f "$ar_target"
    exec "$ar" rc "$ar_target" "${ar_objs[@]}"
fi

drv="$CC"; { [ "$want_cxx" = 1 ] && [ "${force_cdriver:-0}" = 0 ]; } && drv="$CXX"

if [ -n "${QCC_DEBUG:-}" ]; then
    printf 'qcc-shim: %s' "$drv" >&2
    for x in "${args[@]:-}"; do printf ' %s' "$x" >&2; done
    printf '\n' >&2
fi

exec "$drv" "${args[@]}"
