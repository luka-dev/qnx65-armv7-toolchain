#!/usr/bin/env bash
# Compatibility shim between modern GCC output and the stock QNX gas 2.19.
#
# gas 2.19 supports the ARM NEON element-alignment hint only in the UAL comma
# spelling "[Rn, :align]". Modern GCC and hand-written NEON commonly emit
# "[Rn:align]" instead. It also predates the ARM-mode `.inst` directive even
# though `.word` has identical semantics for an encoded 32-bit instruction.
#
# GCC 8.5 also spells the Cortex-A9 assembler architecture as
# `armv7-a+mp+sec` and emits matching `.arch_extension mp/sec` metadata. QNX
# gas 2.19 understands the underlying ARMv7-A instructions but predates that
# feature-suffix/directive syntax, so normalize the flag and remove only those
# two metadata directives.
#
# Rewrite only those exact forms. In particular, do not touch Thumb `.inst.n`
# or `.inst.w`: they require separate width/endianness handling and validation.
set -euo pipefail

# Nothing in-tree passes -B at this shim any more. It remains useful only for
# external callers using the :4.9 variant's gas 2.19; :8.5 defaults to gas 2.38,
# which understands every form this shim was written to rewrite.
#
# It deliberately forwards to the DEFAULT assembler, not to -as-2.19: pointing
# it back at 2.19 would silently reintroduce the mis-encoding for anyone who
# still passes -B here. Kept only so such a caller keeps working.
REAL=/opt/qnx650/host/linux/x86/usr/bin/arm-unknown-nto-qnx6.5.0eabi-as
[ -x "$REAL" ] || REAL=$(command -v arm-unknown-nto-qnx6.5.0eabi-as || true)
if [ -z "${REAL:-}" ] || [ ! -x "$REAL" ]; then
    echo "gas-compat shim: real assembler (…eabi-as) not found" >&2
    exit 127
fi

rewrite() {
    sed -E \
        -e 's/\[([a-z0-9]+):([0-9]+)\]/[\1, :\2]/g' \
        -e 's/^([[:space:]]*)\.inst([[:space:]]+)/\1.word\2/' \
        -e '/^[[:space:]]*\.arch_extension[[:space:]]+(mp|sec)[[:space:]]*$/d'
}

args=()
tmpfiles=()
cleanup() { [ "${#tmpfiles[@]}" -gt 0 ] && rm -f "${tmpfiles[@]}"; }
trap cleanup EXIT

skipnext=0
for a in "$@"; do
    if [ "$skipnext" = 1 ]; then args+=("$a"); skipnext=0; continue; fi
    case "$a" in
        -march=armv7-a+*)                       # gas 2.19 predates +feature syntax
            args+=("-march=armv7-a") ;;
        -o|-I|-mcpu|-mfpu|-march|--defsym)      # option that takes a value
            args+=("$a"); skipnext=1 ;;
        -*)                                     # any other flag
            args+=("$a") ;;
        *.s|*.S|*.asm|*.sx)                     # a source file -> rewrite it
            if [ -f "$a" ]; then
                t=$(mktemp --suffix=.s); tmpfiles+=("$t")
                rewrite < "$a" > "$t"; args+=("$t")
            else
                args+=("$a")
            fi ;;
        *)  args+=("$a") ;;
    esac
done

# GCC normally passes a temporary .s file. If assembly instead arrives on
# stdin (-pipe), filter that stream when no source-file argument was rewritten.
if [ "${#tmpfiles[@]}" -eq 0 ] && [ ! -t 0 ]; then
    exec "$REAL" "${args[@]}" < <(rewrite)
fi
exec "$REAL" "${args[@]}"
