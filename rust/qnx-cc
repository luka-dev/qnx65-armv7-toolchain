#!/usr/bin/env bash
# Linker shim for the Rust std target, in-image version: cargo invokes it as the
# target linker (`-C linker=`); forward argv straight to the QNX 6.5 gcc in this
# image - no nested docker.
#  - QNX 6.5 gcc ships only static libgcc.a (no libgcc_s.so) + rustc uses
#    -nodefaultlibs, so remap -lgcc_s -> -lgcc.
#  - -nodefaultlibs makes the spec drop the target sysroot -L; add it back.
#  - ARM EHABI libgcc has _Unwind_GetIP only as an inline; std wants the symbol,
#    so link our shim archive (shim/libqnxunwind.a, built at image build).
HERE="$(cd "$(dirname "$0")" && pwd)"
SYSLIB=/opt/qnx650/target/qnx6/armle-v7/lib
args=()
for a in "$@"; do
  case "$a" in
    -lgcc_s) args+=("-lgcc") ;;
    *) args+=("$a") ;;
  esac
done
exec arm-unknown-nto-qnx6.5.0eabi-gcc -L "$SYSLIB" "${args[@]}" "$HERE/shim/libqnxunwind.a"
